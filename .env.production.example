# Production environment — copy to server/.env on your host

# MySQL (most common on cPanel):
DATABASE_URL="mysql://DB_USER:DB_PASS@localhost:3306/DB_NAME"

# Or PostgreSQL if you installed it:
# DATABASE_URL="postgresql://DB_USER:DB_PASS@localhost:5432/DB_NAME"

SESSION_SECRET="generate-a-long-random-string-minimum-32-chars"
PORT=3000
NODE_ENV=production

STORAGE_PROVIDER=local
# Absolute path to a writable directory outside public_html:
UPLOAD_DIR=/home/YOUR_CPANEL_USER/wstrack-uploads

SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@yourdomain.com
APP_BASE_URL=https://yourdomain.com
