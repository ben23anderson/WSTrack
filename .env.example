DATABASE_URL="postgresql://user:password@localhost:5432/wstrack"
SESSION_SECRET="change-me-to-a-long-random-string"
PORT=3000
NODE_ENV=development

# Storage: 'local' | 's3'
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads

# S3 / R2 (when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@wstrack.app
APP_BASE_URL=http://localhost:5173
